# VM profile: 2 vCPU / 8 GiB RAM per VM (Azure: Standard_D2as_v4 / Standard_D2s_v4; any 2 vCPU / 8 GB box).
# This is the profile of the small trial cluster: 1 Kafka broker + Spark master on one VM, 2 worker VMs.
# Selected with VM_PROFILE=vm_8gb_2cpu in cluster.env. Everything here is fixed by the size of the VM, not by the site.
#
# Each line is ': "${VAR:=default}"': the value below is used only if cluster.env has not already set VAR,
# so any single value can be overridden in cluster.env without copying this file.
#
# Budget (MB) that lib.sh checks against VM_MEMORY, using the values below:
#   worker : 1 executor x (4096 + 1536) + 512 daemon + 1024 OS                                   = 7168
#   master : 1 Kafka container x 1536 + 512 daemon + 1024 driver + 384 driver overhead + 1024 OS  = 4480
# (the kernel of an "8 GB" VM reports about 7.6-7.8 GB, so keep roughly 0.5 GB of slack on the worker;
#  the master has room for a second driver, about 1.4 GB)
# With KAFKA_BROKER_COUNT=3 on the master the budget would be 7552 MB: too tight, use bigger VMs for that.

# ---- the VM itself ------------------------------------------------------------------------
: "${VM_MEMORY:=8g}"                      # RAM of every VM; lib.sh checks the budgets against it
: "${OS_RESERVE_MB:=1024}"                # kernel, sshd, docker daemon, NFS, page cache the box needs to stay responsive
: "${DRIVER_OVERHEAD_MB:=384}"            # JVM off-heap + Python driver process on top of spark.driver.memory

# ---- Kafka brokers (containers on KAFKA_HOST; how many is KAFKA_BROKER_COUNT in cluster.env) ---------------
: "${KAFKA_HEAP:=1g}"                     # JVM heap per broker
: "${KAFKA_CONTAINER_MEMORY:=1536m}"      # Docker memory limit per broker (heap + off-heap + page cache)

# ---- Spark worker VM -----------------------------------------------------------------------
# Executors per worker = SPARK_WORKER_CORES / SPARK_EXECUTOR_CORES  (2 / 2 = 1).
: "${SPARK_WORKER_CORES:=2}"
: "${SPARK_WORKER_MEMORY:=4g}"            # = executors x SPARK_EXECUTOR_MEMORY (the overhead is not counted here)
: "${SPARK_EXECUTOR_CORES:=2}"            # spark.executor.cores
: "${SPARK_EXECUTOR_MEMORY:=4g}"
: "${SPARK_EXECUTOR_MEMORY_OVERHEAD:=1536m}"  # where the Python workers (2 x pandas / torch) live
: "${SPARK_DAEMON_MEMORY:=512m}"          # heap of the master / worker daemons

# ---- Spark master VM (drivers run here, next to the broker) -----------------------------------
: "${SPARK_DRIVER_MEMORY:=1g}"
