# VM profile: 4 vCPU / 8 GiB RAM per VM (Azure: Standard_F4s_v2; AWS: c5.xlarge-like; any 4 vCPU / 8 GB box).
# Everything here is fixed by the size of the VM, not by the site. Selected with VM_PROFILE=vm_8gb_4cpu in cluster.env.
#
# Each line is ': "${VAR:=default}"': the value below is used only if cluster.env has not already set VAR,
# so any single value can be overridden in cluster.env without copying this file.
#
# Budget (MB) that lib.sh checks against VM_MEMORY, using the values below:
#   worker : 2 executors x (2048 + 768) + 512 daemon + 1024 OS             = 7168
#   master : 3 Kafka containers x 1280 + 512 daemon + 1024 driver + 384 driver overhead + 1024 OS = 6784
# (the kernel of an "8 GB" VM reports about 7.6-7.8 GB, so keep roughly 0.5 GB of slack)

# ---- the VM itself ------------------------------------------------------------------------
: "${VM_MEMORY:=8g}"                      # RAM of every VM; lib.sh checks the budgets against it
: "${OS_RESERVE_MB:=1024}"                # kernel, sshd, docker daemon, NFS, page cache the box needs to stay responsive
: "${DRIVER_OVERHEAD_MB:=384}"            # JVM off-heap + Python driver process on top of spark.driver.memory

# ---- Kafka brokers (3 containers on KAFKA_HOST) ----------------------------------------------
: "${KAFKA_HEAP:=768m}"                   # JVM heap per broker
: "${KAFKA_CONTAINER_MEMORY:=1280m}"      # Docker memory limit per broker (heap + off-heap + page cache)

# ---- Spark worker VM -----------------------------------------------------------------------
# Executors per worker = SPARK_WORKER_CORES / SPARK_EXECUTOR_CORES  (4 / 2 = 2).
: "${SPARK_WORKER_CORES:=4}"
: "${SPARK_WORKER_MEMORY:=4g}"            # = executors x SPARK_EXECUTOR_MEMORY (the overhead is not counted here)
: "${SPARK_EXECUTOR_CORES:=2}"            # spark.executor.cores
: "${SPARK_EXECUTOR_MEMORY:=2g}"
: "${SPARK_EXECUTOR_MEMORY_OVERHEAD:=768m}"   # where the Python workers (pandas, torch) live
: "${SPARK_DAEMON_MEMORY:=512m}"          # heap of the master / worker daemons

# ---- Spark master VM (drivers run here, next to the 3 brokers) ---------------------------------
: "${SPARK_DRIVER_MEMORY:=1g}"
