# VM profile: 4 vCPU / 16 GiB RAM per VM (Azure: Standard_D4s_v5). UNTESTED sizing: same 2 executors x 2 cores per worker
# as the 8 GB profile, with more memory per executor and per broker. Select with VM_PROFILE=vm_16gb_4cpu in cluster.env.
#
# Each line is ': "${VAR:=default}"': the value below is used only if cluster.env has not already set VAR.
#
# Budget (MB) that lib.sh checks against VM_MEMORY, using the values below:
#   worker : 2 executors x (4096 + 1024) + 512 daemon + 1024 OS                                  = 11776
#   master : 3 Kafka containers x 1536 + 512 daemon + 2048 driver + 384 driver overhead + 1024 OS = 8576

# ---- the VM itself ------------------------------------------------------------------------
: "${VM_MEMORY:=16g}"
: "${OS_RESERVE_MB:=1024}"
: "${DRIVER_OVERHEAD_MB:=384}"

# ---- Kafka brokers (3 containers on KAFKA_HOST) ----------------------------------------------
: "${KAFKA_HEAP:=1g}"
: "${KAFKA_CONTAINER_MEMORY:=1536m}"

# ---- Spark worker VM -----------------------------------------------------------------------
: "${SPARK_WORKER_CORES:=4}"
: "${SPARK_WORKER_MEMORY:=8g}"
: "${SPARK_EXECUTOR_CORES:=2}"
: "${SPARK_EXECUTOR_MEMORY:=4g}"
: "${SPARK_EXECUTOR_MEMORY_OVERHEAD:=1g}"
: "${SPARK_DAEMON_MEMORY:=512m}"

# ---- Spark master VM -----------------------------------------------------------------------
: "${SPARK_DRIVER_MEMORY:=2g}"
